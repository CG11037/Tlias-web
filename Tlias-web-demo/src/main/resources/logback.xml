<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logback 日志配置文件
    包含：控制台输出、文件输出、日志级别开关
-->
<configuration>
    <!-- ==================== 控制台输出 ==================== -->
    <!-- 控制台 Appender：输出到标准输出，开发调试时使用 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <!-- 编码格式 -->
        <encoder>
            <!-- 日志格式：时间 [线程] 级别 %logger{类名全限定名长度} - 消息%n换行 -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
            <!-- 控制台使用 UTF-8 编码，避免中文乱码 -->
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ==================== 系统文件输出 ==================== -->
    <!-- 文件 Appender：记录所有级别日志到文件，用于问题排查和审计 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 当前日志文件路径 -->
        <file>logs/tlias-web.log</file>
        <!-- 编码格式 -->
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>

        <!-- 日志文件滚动策略：按日期和大小切分 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 归档文件命名：logs/年-月/文件名-日期.%i.log -->
            <fileNamePattern>logs/%d{yyyy-MM}/tlias-web-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <!-- 单个日志文件最大 10MB，超过则切分 -->
            <maxFileSize>10MB</maxFileSize>
            <!-- 日志文件保留天数 -->
            <maxHistory>30</maxHistory>
            <!-- 所有日志文件总大小上限 -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ==================== 错误日志单独输出 ==================== -->
    <!-- 将 ERROR 级别日志单独记录，便于快速定位错误 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/tlias-web-error.log</file>
        <!-- 只记录 ERROR 级别 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/%d{yyyy-MM}/tlias-web-error-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>60</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- ==================== 项目包日志级别控制 ==================== -->
    <!--
        项目代码使用 DEBUG 级别，方便开发调试
        如需关闭详细日志，将 level 改为 INFO 或 WARN 即可
    -->
    <logger name="cg.example.tliaswebdemo" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>

    <!-- MyBatis SQL 日志：开发时开启 DEBUG 可查看 SQL 语句，上线后改 WARN -->
    <logger name="cg.example.tliaswebdemo.mapper" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>
    <!-- ==================== 全局日志级别 ==================== -->
    <!--
        全局默认级别：INFO
        - DEBUG：输出所有调试信息（开发推荐）
        - INFO ：输出关键运行信息（生产推荐）
        - WARN ：只输出警告和错误
        - ERROR：只输出错误
        - OFF ：关闭所有日志
        - ALL ：打开所有日志
        - =   : 大于等于当前级别的日志都输出
    -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </root>

</configuration>
